# FastAPI / Lingua backend environment variables

# REQUIRED: PostgreSQL DSN used by SQLAlchemy/psycopg2
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lingua
DATABASE_URL=

# Optional: restrict CORS in production.
# If unset/empty, the backend defaults to allow_origins=["*"] for MVP/dev convenience.
# If set, provide a comma-separated list of allowed origins (no spaces preferred).
# Example:
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-frontend.example.com
CORS_ALLOW_ORIGINS=
